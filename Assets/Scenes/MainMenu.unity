    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=\n\u042D\u0442\u043E \u0430\u0440\u043A\u0430\u0434\u043D\u0430\u044F
    \u0438\u0433\u0440\u0430 \u0432 \u0434\u0443\u0445\u0435 Geometry Dash, \n\u0432
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C
    Shigima \u2014 \u0445\u0430\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u043C
    \u0433\u0435\u0440\u043E\u0435\u043C, \n\u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u044B\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u0435\u0442
    \"\u042D\u0443 \u043C\u0430 \u0431\u043E\u0439!\" \u043A\u0430\u043A \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0433\u0430\u043D\u0433\u0441\u0442\u0435\u0440.\n\n\u0413\u0435\u0439\u043C\u043F\u043B\u0435\u0439
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D \u043D\u0430 \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u0438
    \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0439 \u0438 \u043B\u043E\u0432\u043A\u043E\u043C
    \u0441\u0431\u043E\u0440\u0435 \u043F\u0443\u043B\u044C, \n\u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0445
    \u0434\u043B\u044F \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0434\u0443\u044D\u043B\u0438
    \u0441 \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0437\u043B\u043E\u0434\u0435\u0435\u043C
    \u2014 Baebrix\u2019\u043E\u043C \n(\u043E\u043D \u0436\u0435 \u0430\u0434\u043E\u043B\u044C\u0444
    \u043A\u0440\u0438\u043F\u0435\u0440). \n\n\u0421\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
    \u0443 \u0438\u0433\u0440\u043E\u043A\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0441\u043E\u0431\u0430\u044F \u0441\u0443\u043F\u0435\u0440-\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \"le dash\",\n\u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u0441\u043B\u043E\u0436\u043D\u044B\u0435
    \u0443\u0447\u0430\u0441\u0442\u043A\u0438 \u0443\u0440\u043E\u0432\u043D\u0435\u0439.\n\n\u0412
    \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u0430\u044F \u0443\u0441\u043F\u0435\u0448\u043D\u0430\u044F
    \u043F\u043E\u043F\u044B\u0442\u043A\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0441\u044F
    \u0437\u0440\u0435\u043B\u0438\u0449\u043D\u043E\u0439 \u043A\u0430\u0442\u0441\u0446\u0435\u043D\u043E\u0439-\u043F\u043E\u0435\u0434\u0438\u043D\u043A\u043E\u043C
    \u043D\u0430 \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440\u0430\u0445,
    \u0433\u0434\u0435 \u0432\u0441\u0451 \u0440\u0435\u0448\u0430\u044E\u0442 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435
    \u043F\u043E \u043F\u0443\u0442\u0438 \u043F\u0443\u043B\u0438.\n=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=\n          
    -ChatGPT\n\n(\u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u043F\u0440\u0430\u0432\u0434\u0430
    \u043E\u0442 \u0447\u0430\u0441\u0442\u0438)"
